NEKO_ENV=development
NEKO_RELEASE_GATE=SIMULATION
NEKO_DATABASE_URL=sqlite:///./data/neko.db
# 生产 MySQL 示例：mysql+pymysql://neko:password@127.0.0.1:3306/neko_ai?charset=utf8mb4
NEKO_SECRET_KEY=replace-with-at-least-32-random-characters
NEKO_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NEKO_AUTO_START=10:00
NEKO_AUTO_END=23:30
NEKO_DAILY_SEND_LIMIT=500
NEKO_DAILY_SEND_HARD_LIMIT=1000
NEKO_CONTACT_PER_MINUTE=5
NEKO_NAPCAT_TEXT_SAFE_LIMIT=1200
NEKO_HUMAN_TAKEOVER_MINUTES=10
NEKO_FAILURE_CIRCUIT_BREAKER_COUNT=3
NEKO_FAILURE_CIRCUIT_BREAKER_WINDOW_MINUTES=10
NEKO_LOG_RETENTION_DAYS=7
# 仅在使用自建标准化 QQ 桥接端点时设置；官方 Webhook 使用 Ed25519 验签。
NEKO_CONNECTOR_SHARED_TOKEN=replace-with-a-long-random-bridge-token
